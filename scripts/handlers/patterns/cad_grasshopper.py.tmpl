def _count_uuid_shaped_blocks(raw: bytes) -> int:
    """Count 16-byte sequences whose 7th byte's upper nibble is 4.

    Per RFC 4122 v4, the version byte (byte 6) has its high nibble
    set to ``0x40``. Real GH definitions store component instance
    GUIDs as v4 UUIDs; counting these gives a usable proxy for the
    number of components in the graph. False-positive rate is low —
    on random binary data the probability of any given byte matching
    the pattern is ~6%, but the distinct-UUID requirement (we
    de-duplicate) pulls the false-positive count toward zero.
    """
    if not raw:
        return 0
    found: set = set()
    for i in range(0, len(raw) - 16):
        if (raw[i + 6] & 0xF0) != 0x40:
            continue
        # Require non-zero bytes at the boundaries to filter out
        # long zero runs that otherwise satisfy the version check.
        if raw[i] == 0 and raw[i + 15] == 0:
            continue
        found.add(raw[i:i + 16])
    return len(found)


def _scan_nicknames(raw: bytes) -> list:
    """Return de-duplicated human-name candidates from the binary."""
    if not raw:
        return []
    out: set = set()
    for m in _GH_NICKNAME_RE.finditer(raw):
        try:
            s = m.group().decode("ascii", errors="strict")
        except Exception:
            continue
        s = s.strip()
        if not s or s in _GH_NICKNAME_STOPWORDS:
            continue
        # Reject runs of single characters or obvious filler.
        if len(s) < 5:
            continue
        if s.count(" ") == 0 and not any(c.isalpha() for c in s):
            continue
        out.add(s)
    return sorted(out)


def _human_size(n: int) -> str:
    if n < 1024:
        return f"{{n}} B"
    units = ["KB", "MB", "GB"]
    val = float(n) / 1024.0
    for u in units:
        if val < 1024.0:
            return f"{{val:.1f}} {{u}}"
        val /= 1024.0
    return f"{{val:.1f}} TB"


