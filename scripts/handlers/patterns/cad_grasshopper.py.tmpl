def _read_ghx_text(path: str) -> str:
    """Walk the GHX XML and extract component Name/NickName values."""
    p = Path(path)
    try:
        size = p.stat().st_size
        mtime = p.stat().st_mtime
    except OSError:
        size = 0
        mtime = 0.0
    import datetime as _dt
    mtime_iso = (
        _dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
        if mtime else "unknown"
    )

    names: set = set()
    try:
        tree = _ET.parse(path)
        root = tree.getroot()
        # GHX uses ``<items>`` blocks containing ``<item name="Name">``
        # and ``<item name="NickName">`` entries. Walk every item
        # element and collect the text content where the name attr
        # is in the salient set.
        salient = {{"Name", "NickName", "Description"}}
        for item in root.iter("item"):
            attr_name = item.attrib.get("name") or ""
            if attr_name in salient and item.text:
                text = item.text.strip()
                if text and text not in _GH_NICKNAME_STOPWORDS:
                    names.add(text)
    except _ET.ParseError as exc:
        logger.debug("ghx parse failed for %s: %s", path, exc)
    except OSError as exc:
        logger.debug("ghx open failed for %s: %s", path, exc)

    name_block = (
        "\n".join(f"- {{n}}" for n in sorted(names)[:100])
        if names else "_(no Name/NickName/Description items found)_"
    )
    truncated_note = (
        "\n_(showing first 100 of {{}} names)_".format(len(names))
        if len(names) > 100 else ""
    )
    size_human = _human_size(size)
    return (
        f"# Grasshopper definition: {{p.name}}\n"
        f"\n"
        f"- Size: {{size_human}} ({{size}} bytes)\n"
        f"- Modified: {{mtime_iso}}\n"
        f"- Format: McNeel Grasshopper XML (.ghx; readable via stdlib)\n"
        f"\n"
        f"## Components\n"
        f"\n"
        f"- Distinct Name/NickName/Description values: {{len(names)}}\n"
        f"\n"
        f"### Names\n"
        f"\n"
        f"{{name_block}}{{truncated_note}}\n"
    )
