def _read_via_xlrd(path: str) -> str:
    try:
        import xlrd  # type: ignore
        workbook = xlrd.open_workbook(path)
        parts = []
        for sheet in workbook.sheets():
            sheet_lines = []
            for row_idx in range(sheet.nrows):
                row_cells = []
                for cell in sheet.row(row_idx):
                    val = cell.value
                    if val is not None and str(val).strip():
                        row_cells.append(str(val))
                if row_cells:
                    sheet_lines.append("\t".join(row_cells))
            if sheet_lines:
                parts.append(f"Sheet: {{sheet.name}}\n" + "\n".join(sheet_lines))
        return "\n\n".join(parts)
    except Exception as exc:
        logger.debug("xlrd failed for %s: %s", path, exc)
        return ""


def _find_soffice() -> str:
    for name in _SOFFICE_BINARIES:
        exe = shutil.which(name)
        if exe:
            return exe
    for app in _SOFFICE_MACOS_APPS:
        if Path(app).exists():
            return app
    return ""


def _read_via_soffice(path: str) -> str:
    """Run `soffice --headless --convert-to csv` and read the CSV back."""
    exe = _find_soffice()
    if not exe:
        return ""
    with tempfile.TemporaryDirectory() as td:
        try:
            proc = subprocess.run(
                [exe, "--headless", "--convert-to", "csv", "--outdir", td, path],
                capture_output=True,
                timeout=_SOFFICE_TIMEOUT_SECS,
                check=False,
            )
        except Exception as exc:
            logger.debug("soffice invocation failed for %s: %s", path, exc)
            return ""
        if proc.returncode != 0:
            logger.debug(
                "soffice returned %d for %s: %s",
                proc.returncode, path, proc.stderr[:200],
            )
            return ""
        out_file = Path(td) / f"{{Path(path).stem}}.csv"
        if not out_file.exists():
            return ""
        try:
            raw = out_file.read_bytes()
            for codec in ("utf-8", "gbk", "shift_jis", "latin-1"):
                try:
                    return raw.decode(codec, errors="strict")
                except Exception:
                    continue
            return raw.decode("latin-1", errors="replace")
        except Exception as exc:
            logger.debug("soffice csv read failed: %s", exc)
            return ""
