v16.11.0 (FGE Ask 1). OFD is China's nationally standardised
electronic-document format (GB/T 33190-2016). Used for invoices,
contracts, tax documents, and government forms — every Chinese
enterprise archive carries them. Pre-v16.11 OFD files silently
dropped as ``unknown file type``.

The format is a zip container with this layout:

    /OFD.xml                  — manifest pointing at the document(s)
    /Doc_0/Document.xml       — page list + resource refs
    /Doc_0/Pages/Page_0/Content.xml   — page content stream
    /Doc_0/Pages/Page_0/...
    /Doc_0/PublicRes/...      — embedded fonts, images
    /Doc_0/Res/...            — document-specific resources
    /Doc_0/Annotations/...    — comments, signatures

Text lives in ``<ofd:TextCode>`` elements inside ``Content.xml``;
the handler walks every ``Content.xml`` it finds in the zip and
concatenates the text. No pip dependency — pure stdlib.

Image extraction is opportunistic: scans the first 8 MiB of the
zip's raw bytes for the JFIF SOI marker (every OFD with an
embedded preview thumbnail carries one near the head, mirroring
the design-indd handler's approach).

Never raises.
"""
import logging
import os
import zipfile
from pathlib import Path
from xml.etree import ElementTree as _ET

logger = logging.getLogger(__name__)

CAPABILITIES = {{
    "read_text": True,
    "extract_images": True,
    "render_pages": False,
}}

# OFD's GB/T 33190 namespace. ElementTree returns tags as
# ``{{ns}}TagName``; the handler strips the namespace before
# matching. We don't rely on any single namespace URI.
_TEXT_TAG_LOCAL_NAMES = {{"TextCode", "PageContent", "Content"}}
# Sniff cap for embedded JFIF preview — 8 MiB matches the design-indd
# handler. The thumbnail is always near the start of the zip.
_JFIF_SCAN_CAP = 8 * 1024 * 1024
_JFIF_SOI = b"\xff\xd8\xff"


def read_text(path: str) -> str:
    """Walk the OFD zip and return concatenated text content.

    Returns ``""`` when the path doesn't exist (PT8 contract).
    Returns a metadata + page-text block on success.
    """
    if not os.path.exists(path):
        return ""
    parts = []
    page_texts = []
    try:
        with zipfile.ZipFile(path) as zf:
            content_xmls = sorted(
                n for n in zf.namelist()
                if n.endswith(".xml") and "/Pages/" in n and n.endswith("Content.xml")
            )
            # Fallback: any Content.xml under any Doc_N (some OFD
            # producers nest pages differently).
            if not content_xmls:
                content_xmls = sorted(
                    n for n in zf.namelist()
                    if n.endswith("Content.xml")
                )
            for name in content_xmls:
                try:
                    raw = zf.read(name)
                except Exception as exc:
                    logger.debug("ofd: read failed for %s: %s", name, exc)
                    continue
                page_text = _extract_text_from_xml(raw)
                if page_text:
                    page_texts.append(page_text)
    except (zipfile.BadZipFile, OSError) as exc:
        logger.debug("ofd open failed for %s: %s", path, exc)
        return ""

    p = Path(path)
    try:
        size = p.stat().st_size
    except OSError:
        size = 0
    parts.append(f"# OFD document: {{p.name}}")
    parts.append("")
    parts.append(f"- Size: {{size}} bytes")
    parts.append(f"- Pages: {{len(page_texts)}}")
    parts.append(f"- Format: OFD (GB/T 33190-2016)")
    parts.append("")
    if page_texts:
        for i, text in enumerate(page_texts, 1):
            parts.append(f"## Page {{i}}")
            parts.append("")
            parts.append(text)
            parts.append("")
    else:
        parts.append("_No text content found in any page Content.xml._")
    return "\n".join(parts)


def extract_images(path: str, out_dir: str) -> list:
    """Extract any embedded JFIF preview from the OFD zip.

    Returns the JPEG path on success, or [] when no preview is
    found. Never raises.
    """
    if not os.path.exists(path):
        return []
    try:
        with open(path, "rb") as fh:
            raw = fh.read(_JFIF_SCAN_CAP)
    except OSError as exc:
        logger.debug("ofd open failed for %s: %s", path, exc)
        return []
    soi = raw.find(_JFIF_SOI)
    if soi < 0:
        return []
    eoi = raw.find(b"\xff\xd9", soi + 3)
    if eoi < 0:
        return []
    jpeg_bytes = raw[soi:eoi + 2]
    if len(jpeg_bytes) < 1024:
        return []
    try:
        os.makedirs(out_dir, exist_ok=True)
        stem = Path(path).stem
        out_path = os.path.join(out_dir, f"{{stem}}--ofd-preview.jpg")
        with open(out_path, "wb") as fh:
            fh.write(jpeg_bytes)
    except OSError as exc:
        logger.debug("ofd preview write failed for %s: %s", path, exc)
        return []
    return [out_path]


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_CLOSE_BRACE = chr(125)  # literal close-brace; constructed via chr(125) so the template renders cleanly


def _extract_text_from_xml(raw_bytes: bytes) -> str:
    """Walk an OFD page-content XML doc and return concatenated text."""
    try:
        root = _ET.fromstring(raw_bytes)
    except _ET.ParseError as exc:
        logger.debug("ofd xml parse failed: %s", exc)
        return ""
    parts = []
    for elem in root.iter():
        tag = elem.tag
        # Strip namespace if present.
        if _CLOSE_BRACE in tag:
            tag = tag.split(_CLOSE_BRACE, 1)[1]
        if tag in _TEXT_TAG_LOCAL_NAMES and elem.text:
            text = elem.text.strip()
            if text:
                parts.append(text)
    return "\n".join(parts)
