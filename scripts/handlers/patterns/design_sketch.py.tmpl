_CONVERTER_TIMEOUT_SECS = 30


def read_text(path: str) -> str:
    if not os.path.exists(path):
        return ""
    converter = shutil.which("sketchtool")
    if converter:
        text = _run_sketchtool(converter, path)
        if text:
            return text
    return _metadata_summary(path)


def extract_images(path: str, out_dir: str) -> list:
