def _run_sketchtool(exe: str, path: str) -> str:
    try:
        proc = subprocess.run(
            [exe, "list", "pages", path],
            capture_output=True,
            timeout=_CONVERTER_TIMEOUT_SECS,
            check=False,
        )
    except Exception as exc:
        logger.debug("sketchtool failed for %s: %s", path, exc)
        return ""
    if proc.returncode != 0:
        return ""
    raw = proc.stdout or b""
    if not raw:
        return ""
    try:
        return raw.decode("utf-8", errors="replace")
    except Exception:
        return raw.decode("latin-1", errors="replace")


def _metadata_summary(path: str) -> str:
    p = Path(path)
