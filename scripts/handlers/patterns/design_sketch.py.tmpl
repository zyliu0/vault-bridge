        size = p.stat().st_size
        mtime = p.stat().st_mtime
    except OSError:
        size = 0
        mtime = 0.0
    import datetime as _dt
    mtime_iso = (
        _dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
        if mtime else "unknown"
    )
    return (
        f"# Sketch document: {{p.name}}\n"
        f"\n"
        f"- Size: {{size}} bytes\n"
        f"- Modified: {{mtime_iso}}\n"
