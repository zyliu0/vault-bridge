def _run_converter(exe: str, path: str) -> str:
    try:
        proc = subprocess.run(
            [exe, path],
            capture_output=True,
            timeout=_CONVERTER_TIMEOUT_SECS,
            check=False,
        )
    except Exception as exc:
        logger.debug("%s failed for %s: %s", exe, path, exc)
        return ""
