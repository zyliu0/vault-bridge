def _human_size(n: int) -> str:
    if n < 1024:
        return f"{{n}} B"
    units = ["KB", "MB", "GB"]
    val = float(n) / 1024.0
    for u in units:
        if val < 1024.0:
            return f"{{val:.1f}} {{u}}"
        val /= 1024.0
    return f"{{val:.1f}} TB"
