import logging
import os
import re
import struct
import zipfile
from pathlib import Path
from xml.etree import ElementTree as _ET

logger = logging.getLogger(__name__)

CAPABILITIES = {{
    "read_text": True,
    "extract_images": True,
    "render_pages": False,
}}

# JFIF/JPEG SOI marker — every InDesign document has one of these
# near the head (the document thumbnail / proxy image).
_JFIF_SOI = b"\xff\xd8\xff"
# Sniff cap: only scan the first 8 MiB. The thumbnail is always
# near the start; scanning the full file would burn time on large
# (200 MB+) submission documents.
_JFIF_SCAN_CAP = 8 * 1024 * 1024


def _suffix(path: str) -> str:
    return Path(path).suffix.lower().lstrip(".")


def read_text(path: str) -> str:
    """Extract text from an InDesign document.

    .idml: walks the zip's Stories/Story_*.xml entries and returns
    the concatenated <Content> text — usually the full prose of
    every text frame in the document.

    .indd: returns a metadata summary; the binary format is closed
    and the .idml-style export is the only sanctioned path to full
    text.

    Returns ``""`` when the path doesn't exist (PT8 contract).
    """
    if not os.path.exists(path):
        return ""
    suffix = _suffix(path)
    if suffix == "idml":
        return _read_idml_text(path)
    return _indd_metadata_summary(path)


def extract_images(path: str, out_dir: str) -> list:
