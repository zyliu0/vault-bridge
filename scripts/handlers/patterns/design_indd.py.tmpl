# ---------------------------------------------------------------------------
# .idml — XML text extraction
# ---------------------------------------------------------------------------

def _read_idml_text(path: str) -> str:
    """Walk the IDML zip and return concatenated story text."""
    parts: list = []
    try:
        with zipfile.ZipFile(path) as zf:
            story_names = [
                n for n in zf.namelist()
                if n.startswith("Stories/Story_") and n.endswith(".xml")
            ]
            for name in sorted(story_names):
                try:
                    raw = zf.read(name)
                except Exception as exc:
                    logger.debug("idml story read failed for %s: %s", name, exc)
                    continue
                try:
                    root = _ET.fromstring(raw)
                except Exception as exc:
                    logger.debug("idml story parse failed for %s: %s", name, exc)
                    continue
                # IDML uses a default namespace plus per-element ones.
                # The text we want lives in <Content> elements anywhere
                # under the story root.
                _CLOSE_BRACE = chr(125)  # literal closing brace
                for content in root.iter():
                    tag = content.tag
                    # Strip namespace if present (ElementTree returns
                    # tags like ``{{ns}}Content``; we want ``Content``).
                    if _CLOSE_BRACE in tag:
                        tag = tag.split(_CLOSE_BRACE, 1)[1]
                    if tag == "Content" and content.text:
                        text = content.text.strip()
                        if text:
                            parts.append(text)
    except (zipfile.BadZipFile, OSError) as exc:
        logger.debug("idml open failed for %s: %s", path, exc)
        return ""
    except Exception as exc:
        logger.debug("idml extract failed for %s: %s", path, exc)
        return ""
    return "\n\n".join(parts)


# ---------------------------------------------------------------------------
# .indd — JFIF preview extraction
# ---------------------------------------------------------------------------

def _extract_indd_preview(path: str, out_dir: str) -> list:
    """Scan the first ~8 MiB for a JFIF preview and write it out."""
    try:
        with open(path, "rb") as fh:
            raw = fh.read(_JFIF_SCAN_CAP)
    except OSError as exc:
        logger.debug("indd open failed for %s: %s", path, exc)
        return []
    soi = raw.find(_JFIF_SOI)
    if soi < 0:
        return []
    # Find end-of-image (EOI) marker after the SOI.
    eoi = raw.find(b"\xff\xd9", soi + 3)
    if eoi < 0:
        return []
    jpeg_bytes = raw[soi:eoi + 2]
    # Sanity floor — InDesign thumbnails are typically 5-50 KB.
    # Reject implausibly small results so we don't write junk.
    if len(jpeg_bytes) < 1024:
        return []
    try:
        os.makedirs(out_dir, exist_ok=True)
        stem = Path(path).stem
        out_path = os.path.join(out_dir, f"{{stem}}--indd-preview.jpg")
        with open(out_path, "wb") as fh:
            fh.write(jpeg_bytes)
    except OSError as exc:
        logger.debug("indd preview write failed for %s: %s", path, exc)
        return []
    return [out_path]


def _indd_metadata_summary(path: str) -> str:
    """Return a short metadata block when the file is .indd binary.

    The binary format is closed; we surface size + mtime + a
    pointer to the .idml export route so operators can decide
    whether to ask the user for an .idml round-trip.
    """
    p = Path(path)
    try:
        size = p.stat().st_size
        mtime = p.stat().st_mtime
    except OSError:
        size = 0
        mtime = 0.0
    import datetime as _dt
    mtime_iso = (
        _dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
        if mtime else "unknown"
    )
    return (
        f"# InDesign document: {{p.name}}\n"
        f"\n"
        f"- Size: {{size}} bytes\n"
        f"- Modified: {{mtime_iso}}\n"
        f"- Format: Adobe InDesign binary (.indd; closed format)\n"
        f"\n"
        f"_Full text extraction requires .idml export from InDesign. The\n"
        f"plugin extracts the embedded JFIF preview (when present) as a\n"
        f"hero image; for full prose, ask the user to provide the .idml\n"
        f"twin._\n"
    )
